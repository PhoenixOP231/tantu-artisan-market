{
  "name": "tantu-artisan-market",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.js",
    "vite:dev": "vite --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "preview": "npm run build && npm run server",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.js",
    "db:seed": "node --env-file-if-exists=.env server/seed.js",
    "test": "node --test server/*.test.js",
    "check": "npm test && npm run build",
    "deploy:vercel": "npm run check && vercel deploy --prod --yes"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0"
  }
}
