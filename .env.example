PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/tantu.db
# Optional: when set, use hosted Postgres instead of local SQLite.
# DATABASE_URL=postgresql://...
# Optional for local testing with a connected public Vercel Blob store.
# USE_BLOB_STORAGE=1
# Set to 1 only when intentionally loading public demo accounts.
ALLOW_DEMO_SEED=1
# Optional. When set, catalogue suggestions also analyze the uploaded photo.
# Artisan notes and photo are sent to the OpenAI Responses API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
